# Weather Intelligence Service configuration sample. Copy to .env and fill in real values.
# Never commit real secrets.

# Required. WeatherAPI.com key. Never accepted from request input and never logged.
WEATHERAPI_KEY=

# development | production | test (default: development)
NODE_ENV=development

# Bind address. Default 127.0.0.1. Public mode requires an explicit non-loopback host.
HOST=127.0.0.1
PORT=3000

# local | public (default: local). Public mode requires CACHE_BACKEND=redis and HOST_ALLOWLIST.
EXPOSURE_MODE=local

# Comma-separated host allowlist. Required and non-empty in public mode.
HOST_ALLOWLIST=

# Comma-separated Origin allowlist for browser access. Empty disables CORS.
ORIGIN_ALLOWLIST=

# memory | redis (default: memory)
CACHE_BACKEND=memory

# Required when CACHE_BACKEND=redis. Example: redis://127.0.0.1:6379
REDIS_URL=

# Memory cache entry bound, 100-10000 (default: 1000)
CACHE_MAX_ENTRIES=1000

# Monthly WeatherAPI call budget. Default 90000; above 95000 requires the unsafe override.
PROVIDER_MONTHLY_BUDGET=90000
# UNSAFE_ALLOW_HIGH_PROVIDER_BUDGET=true

# HTTP requests per rolling minute per IP (default: 60)
RATE_LIMIT_PER_MINUTE=60

# Emergency provider attempts per rolling minute while the shared quota is unavailable (default: 5)
EMERGENCY_LIMIT_PER_MINUTE=5

# Maximum request processing deadline in milliseconds (default: 10000)
REQUEST_DEADLINE_MS=10000

# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Opt-in live provider smoke test. Never enable in CI.
RUN_LIVE_WEATHERAPI_TESTS=false
